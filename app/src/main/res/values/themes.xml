<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the visual theme. This XML theme only controls the window
      before the first frame, so the launch never flashes the wrong colour.
    -->
    <style name="Theme.Cadence" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cadence_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
