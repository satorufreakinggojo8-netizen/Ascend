<?xml version="1.0" encoding="utf-8"?>
<!--
  Workout history is local-only by design, so it is excluded from cloud backup
  and from device-to-device transfer. Use the in-app export instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
